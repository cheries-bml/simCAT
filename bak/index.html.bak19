let i=t?.topic,L=i?.category||"",s=i?.name?.en||i?.name||"",v=i?.name?.id||i?.name?.en||"";
let title=slugTitle||s||"";
let Blu=nt?{bg:"#0F1B2D",bd:"#1E3A5F",tx:"#93C5FD",tx2:"#60A5FA"}:{bg:"#EFF6FF",bd:"#BFDBFE",tx:"#1E40AF",tx2:"#2563EB"};
let Yel=nt?{bg:"#1A1A0A",bd:"#3F3F1A",tx:"#FDE68A",tx2:"#FACC15"}:{bg:"#FEFCE8",bd:"#FDE68A",tx:"#92400E",tx2:"#CA8A04"};
