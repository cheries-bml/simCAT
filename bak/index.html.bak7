<!DOCTYPE html><html lang="en"><head><style>@font-face{font-family: "Optimistic";font-style: normal;font-weight: 400 600;font-display: swap;src: url("/fonts/OptimisticAI_VF_Optimized.woff2") format("woff2");}@font-face{font-family: "Optimistic Mono";font-style: normal;font-weight: 400;font-display: swap;src: url("/fonts/OptimisticMono_W_TextRegular.woff2") format("woff2");}:where(html){font-family: "Optimistic",system-ui,sans-serif;}:where(code,pre,kbd,samp){font-family: "Optimistic Mono",ui-monospace,monospace;}</style><style data-metaai-safe-area>:root{scroll-padding-top: var(--safe-area-scroll-padding-top,0px);}[data-safe-area-inset-root]::before{background: inherit;content: "";height: var(--safe-area-inset-top,0px);inset: 0 0 auto;pointer-events: none;position: fixed;z-index: 2147483647;}</style><script data-metaai-safe-area-runtime>// (c) Meta Platforms, Inc. and affiliates. Confidential and proprietary.
(() => {
  const params = new URLSearchParams(window.location.search);
  const rawInset = params.get('top_inset_px');
  const parsedInset = rawInset !== null && /^\d+$/.test(rawInset)
    ? Number(rawInset)
    : 0;
  const topInset = params.get('has_top_banner') === '1'
    ? Math.min(parsedInset, 256)
    : 0;
  document.documentElement.style.setProperty('--safe-area-inset-top', `${topInset}px`);
  document.documentElement.style.setProperty('--safe-area-scroll-padding-top', `${topInset}px`);
  function observeNavigation() {
    const root = document.getElementById('root');
    if (root === null) return;
    const observed = new Set();
    let scheduled = false;
    function syncScrollPadding() {
      const elements = new Set(root.querySelectorAll('[data-safe-area-sticky-top]'));
      for (const element of observed) {
        if (!elements.has(element)) {
          resizeObserver.unobserve(element);
          observed.delete(element);
        }
      }
      for (const element of elements) {
        if (!observed.has(element)) {
          resizeObserver.observe(element);
          observed.add(element);
        }
      }
      let padding = topInset;
      for (const element of elements) {
        const style = window.getComputedStyle(element);
        if (style.position !== 'sticky' && style.position !== 'fixed') continue;
        const top = Number.parseFloat(style.top);
        if (Number.isFinite(top)) {
          padding = Math.max(padding, top + element.getBoundingClientRect().height);
        }
      }
      document.documentElement.style.setProperty(
        '--safe-area-scroll-padding-top', `${Math.ceil(padding)}px`,
      );
    }
    function scheduleUpdate() {
      if (scheduled) return;
      scheduled = true;
      queueMicrotask(() => {
        scheduled = false;
        syncScrollPadding();
      });
    }
    const resizeObserver = new ResizeObserver(scheduleUpdate);
    const mutationObserver = new MutationObserver(scheduleUpdate);
    mutationObserver.observe(root, {
      attributeFilter: ['class', 'data-safe-area-sticky-top', 'hidden', 'style'],
      attributes: true,
      childList: true,
      subtree: true,
    });
    window.addEventListener('resize', scheduleUpdate);
    scheduleUpdate();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', observeNavigation, {once: true});
  } else {
    observeNavigation();
  }
})();
</script>
