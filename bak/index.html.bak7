        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');
        *{box-sizing:border-box}
        html{scroll-behavior:smooth}
        body{margin:0; font-size:16px; line-height:1.7; letter-spacing:0em}
        .notranslate { translate: no; }
        [translate="no"] { translate: no; }
        .goog-te-banner-frame, .goog-te-balloon-frame, #goog-gt-tt, .goog-te-menu-value, .goog-te-gadget { display:none !important; }
        body { top:0 !important; }
        ::selection{background:var(--primary); color:${re}}
        ::-webkit-scrollbar{width:8px;height:8px}
        ::-webkit-scrollbar-track{background:transparent}
        ::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:999px;border:2px solid var(--bg)}
        ::-webkit-scrollbar-thumb:hover{background:var(--text-faint)}
        input:focus, select:focus, textarea:focus{outline:none; box-shadow:0 0 0 3px var(--ring); border-color:var(--primary) !important}
        button:focus-visible, a:focus-visible{outline:none; box-shadow:0 0 0 3px var(--ring)}
        button{font-family:inherit; -webkit-tap-highlight-color:transparent}
        .mono{font-family:'Geist Mono','JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace}
        .heading{font-family:'Geist','Geist Sans','Plus Jakarta Sans','Inter',system-ui,-apple-system,sans-serif; letter-spacing:-0.01em; font-weight:650}
        p, li, span, div{letter-spacing:0em}
        .card-hover{transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s}
        .card-hover:hover{border-color:var(--border-hover) !important; box-shadow:var(--shadow-md) !important; transform:translateY(-1px)}
        .btn-primary{transition: transform 0.12s, box-shadow 0.12s, background 0.12s, opacity 0.12s}
        .btn-primary:hover{transform:translateY(-1px); box-shadow:var(--shadow-lg)}
        .btn-primary:active{transform:translateY(0px)}
        .nav-link{transition: all 0.15s ease}
        .nav-link:hover{border-color:var(--border-hover) !important; background:var(--accent) !important; color:var(--text) !important}
        .token-btn{transition: all 0.12s}
        .token-btn:hover{transform:translateY(-1px); border-color:var(--border-hover) !important}
        .question-text{font-size:17px; line-height:1.7; letter-spacing:0em; font-weight:550}
        .passage-text{font-size:16px; line-height:1.75; letter-spacing:0em}
        .option-text{font-size:15.5px; line-height:1.6; letter-spacing:0em}
        .test-layout > *{min-width:0}
        .test-sidebar{position:sticky; top:88px}
        .test-question-area{min-width:0; width:100%; overflow:visible}
        .start-bar{position:sticky; top:88px; z-index:2}
        .sticky-buttons-bar{position:sticky; top:0; z-index:3; backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px)}
        /* v2.6.9 clickable segment style */
        .clickable-seg{
          background:var(--card);
          border:1.5px dashed var(--border-strong);
          border-radius:8px;
          padding:4px 10px;
          cursor:pointer;
          position:relative;
          box-shadow:var(--shadow);
          font-weight:550;
          font-size:14px;
          transition: all 0.14s ease;
          display:inline-flex;
          align-items:center;
          gap:4px;
          margin:2px;
          color:var(--text);
          line-height:1.4;
        }
        .clickable-seg:hover{
          border-color:var(--primary);
          background:var(--accent);
          transform:translateY(-1px);
          box-shadow:var(--shadow-md);
        }
        .clickable-seg.selected{
          background:#FEF3C7;
          border:1.5px solid #F59E0B;
          color:#92400E;
          box-shadow:var(--shadow);
        }
        [data-theme="black"] .clickable-seg.selected, .black .clickable-seg.selected{
          background:#2a2415 !important;
          border-color:#F59E0B !important;
          color:#FDE68A !important;
        }
        .clickable-seg .clickable-indicator{
          font-size:8px;
          opacity:0.7;
          position:absolute;
          top:-4px;
          right:-4px;
          background:var(--primary);
          color:${re};
          width:14px;
          height:14px;
          border-radius:999px;
          display:grid;
          place-items:center;
          font-weight:800;
          line-height:1;
          box-shadow:var(--shadow);
        }
        .clickable-seg.selected .clickable-indicator{
          background:#F59E0B;
          color:#fff;
        }
        .unclickable-seg{
          padding:4px 6px;
          font-size:15px;
          color:var(--text);
          line-height:1.6;
          opacity:0.9;
          cursor:default;
          display:inline;
        }
        @media (max-width: 900px){
          .dashboard-grid{grid-template-columns:1fr !important}
          .test-layout{grid-template-columns:1fr !important; gap:16px !important}
          .bank-layout{grid-template-columns:1fr !important; gap:16px !important}
          .files-modal{max-width:100% !important; margin:12px}
          .test-layout > *{min-width:0 !important; max-width:100% !important}
          .test-question-area{width:100% !important}
        }
        @media (max-width: 768px){
          .test-layout{grid-template-columns:1fr !important; gap:16px !important; align-items:start !important}
          .test-layout > div:first-child{position:static !important; top:auto !important}
          .test-sidebar{position:static !important; top:auto !important; height:auto !important}
          .sticky-top-mobile{position:static !important; top:auto !important}
          .start-bar{position:static !important; top:auto !important; flex-wrap:wrap !important}
          .bank-layout{grid-template-columns:1fr !important}
          .dashboard-grid{grid-template-columns:1fr !important}
          .main-pad{padding:16px 14px 80px !important}
          .stats-grid{grid-template-columns:repeat(2,1fr) !important}
          .header-inner{padding:12px 16px !important; gap:12px !important}
          .test-question-area{padding:0 !important; display:grid !important; gap:16px !important; min-width:0 !important; width:100% !important; overflow:visible !important}
          .sticky-buttons-bar{position:static !important; top:auto !important}
        }
        @media (max-width: 640px){
          .header-inner{padding:12px 16px !important}
          .main-pad{padding:16px 14px 80px !important}
          .stats-grid{grid-template-columns:1fr 1fr !important}
          .test-layout{grid-template-columns:1fr !important}
          .test-sidebar{position:static !important}
