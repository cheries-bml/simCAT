ns.",timeLimits:{fast:5,normal:10,easy:20}},questions:[{id:"q1",type:"click_correct",question:"Select the incorrect word in the sentence and type the correct form.",sentence:"She doesn't likes to be interrupted during her research.",tokens:["She","doesn't","likes","to","be","interrupted","during","her","research."],incorrectIndex:2,correctAnswers:["like"],explanation:"With auxiliary 'doesn't', base form 'like' is required. 'doesn't likes' is ungrammatical."},{id:"q2",type:"click_correct",question:"Find the error.",sentence:"They was planning to visit the museum yesterday.",tokens:["They","was","planning","to","visit","the","museum","yesterday."],incorrectIndex:1,correctAnswers:["were"],explanation:"Subject-verb agreement: 'They' requires 'were', not 'was'."},{id:"q3",type:"mcq",question:"Choose the correct sentence:",options:{A:"Each of the students have finished.",B:"Each of the students has finished.",C:"Each of the student has finished.",D:"Each students has finished."},correctAnswer:"B",explanation:"'Each' is singular. Correct: Each of the students has finished."}]},"./questions/intermediate/english/reading/question.json":{meta:{title:"Reading Comprehension — Climate",description:"Read passage and answer.",timeLimits:{fast:7,normal:15,easy:25}},questions:[{id:"q1",type:"passage_mcq",passage:"The reversal of ocean currents in the North Atlantic has been linked to abrupt climate shifts. When freshwater influx reduces salinity, density-driven circulation weakens, causing heat transport to stall. Evidence from ice cores suggests such events triggered temperature drops of 5°C within decades.",question:"What weakens density-driven circulation?",options:{A:"Salinity increase",B:"Freshwater influx",C:"Temperature rise",D:"Wind patterns"},correctAnswer:"B",explanation:"Passage states freshwater influx reduces salinity, weakening circulation."},{id:"q2",type:"passage_mcq",passage:"The reversal of ocean currents in the North Atlantic has been linked to abrupt climate shifts. When freshwater influx reduces salinity, density-driven circulation weakens, causing heat transport to stall. Evidence from ice cores suggests such events triggered temperature drops of 5°C within decades.",question:"Ice core evidence indicates:",options:{A:"Gradual warming of 1°C",B:"Sudden drops of 5°C in decades",C:"No correlation with currents",D:"Salinity increase causes warming"},correctAnswer:"B",explanation:"Ice cores show temperature drops of 5°C within decades."},{id:"q3",type:"mcq",question:"Author's tone is:",options:{A:"Speculative but evidence-based",B:"Dismissive",C:"Humorous",D:"Alarmist without data"},correctAnswer:"A",explanation:"Author links hypotheses to ice core evidence."}]},"./questions/advance/math/psychotest/question.json":{meta:{title:"Visual Reasoning & Logic",description:"Image-based reasoning.",timeLimits:{fast:6,normal:12,easy:20}},questions:[{id:"q1",type:"image_mcq",question:"If pattern continues, which completes the sequence? (Visual: ▲ ■ ● → ■ ● ▲ → ? )",image:"https://images.unsplash.com/photo-1639322537224-f01285785c00?w=400&h=200&fit=crop",options:{A:"● ▲ ■",B:"▲ ● ■",C:"● ■ ▲",D:"■ ▲ ●"},correctAnswer:"A",explanation:"Rotation: each row shifts left. ▲■● → ■●▲ → ●▲■."},{id:"q2",type:"mcq",question:"What is next: 2, 6, 12, 20, 30, ?",options:{A:"40",B:"42",C:"44",D:"48"},correctAnswer:"B",explanation:"Pattern n*(n+1): 1*2=2, 2*3=6, 3*4=12, 4*5=20, 5*6=30, 6*7=42."}]},"./questions/easy/history/ancient-egypt/question.json":{meta:{title:"Ancient Egypt Basics",description:"Foundational history.",timeLimits:{fast:4,normal:8,easy:15}},questions:[{id:"q1",type:"mcq",question:"Who unified Upper and Lower Egypt?",options:{A:"Tutankhamun",B:"Narmer (Menes)",C:"Ramses II",D:"Cleopatra"},correctAnswer:"B",explanation:"Narmer Palette documents unification."},{id:"q2",type:"click_correct",question:"Correct the factually incorrect word.",sentence:"The Great Pyramid of Giza was built in Rome as a tomb.",tokens:["The","Great","Pyramid","of","Giza","was","built","in","Rome","as","a","tomb."],incorrectIndex:8,correctAnswers:["Giza","Egypt"],explanation:"Built in Giza, Egypt, not Rome."}]}},od=[{group:"syllabus",topic:"general",name:"Math Syllabus 2025.pdf",path:"./files/syllabus/math-2025.pdf",type:"pdf"},{group:"syllabus",topic:"reading",name:"English Reading Guide.txt",path:"./files/syllabus/english-guide.txt",type:"txt"},{group:"past-papers",topic:"general",name:"Sample Questions.md",path:"./files/past-papers/sample.md",type:"md"},{group:"past-papers",topic:"psychotest",name:"Psychotest Examples.pdf",path:"./files/past-papers/psychotest.pdf",type:"pdf"},{group:"english",topic:"grammar",name:"Grammar1.pdf",path:"files/english/grammar/Grammar.pdf",type:"pdf"},{group:"english",topic:"vocab",name:"Vocab Essentials.pdf",path:"files/english/vocab/Vocab.pdf",type:"pdf"},{group:"math",topic:"algebra",name:"Algebra.pdf",path:"files/math/algebra/Algebra.pdf",type:"pdf"},{group:"math",topic:"geometry",name:"Geometry Notes.txt",path:"files/math/geometry/Geometry.txt",type:"txt"},{group:"history",name:"Ancient Egypt Overview.pdf",path:"./files/history/overview.pdf",type:"pdf"}],id={name:"Atlas Learning Labs",email:"hello@atlas-labs.edu",phone:"+1 (555) 014-2030",address:"12 Archive Row, Boston MA",developer:"Atlas Studio — CAT Edition",github:"github.com/atlas-labs/cat"};class cd extends C.default.Component{constructor(e){super(e);this.state={hasError:!1,error:null}}static getDerivedStateFromError(e){return{hasError:!0,error:e}}componentDidCatch(e,n){console.error("Results page crashed:",e,n)}render(){if(this.state.hasError)return p("div",{style:{background:"var(--card)",border:"1px solid var(--border)",borderRadius:16,padding:24,display:"grid",gap:14},children:[p("div",{style:{display:"flex",alignItems:"center",gap:12},children:[s("div",{style:{width:40,height:40,borderRadius:12,background:"#FEF2F2",border:"1px solid #FECACA",display:"grid",placeItems:"center",fontSize:18},children:"⚠"}),p("div",{children:[s("div",